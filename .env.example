# Copy this file to .env and fill it in. Never commit .env.

# --- Twilio (Console > Account > API keys & tokens) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# The one Twilio number used for everything: resident calls and technician calls. E.164.
TWILIO_PHONE_NUMBER=+15551230000

# --- ElevenLabs ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: run a branch of the agent instead of its main branch (ElevenLabs agent versioning).
# Copy the branch ID (starts with agtbrch_) from the agent's branch menu. Leave empty for main.
ELEVENLABS_BRANCH_ID=

# --- Transfer ---
# Technicians to call, comma-separated E.164. They are called one at a time, in this order.
TECH_NUMBERS=+15551110001,+15551110002
# Keep this "sequential". This branch always calls one technician at a time (and warns at
# startup if this says anything else). main and agent-stays-on-call also accept "parallel",
# and refuse to start on any other value, so "sequential" works on every branch.
DIAL_MODE=sequential

# --- Server ---
# Public https URL that reaches this server (your ngrok URL). No trailing slash, no path.
# Twilio signatures are validated against this URL, so it must match what Twilio calls exactly.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app
# Only for "npm run tunnel", which starts ngrok and fills in PUBLIC_BASE_URL for you.
# Token: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Shared secret for non-Twilio callers: the ElevenLabs request_transfer tool and /start-call
# must send it in the X-Tool-Secret header. Use a long random string, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOOL_SECRET=change_me_to_a_long_random_string

# TwiML App through which Iris joins the call (branch agent-stays-on-call).
# Leave empty and run: node scripts/setup-agent-app.js   (it creates the app and fills this in)
TWILIO_AGENT_APP_SID=

# --- Optional (defaults shown) ---
# PORT=3000
# RING_TIMEOUT_SEC=20
# Hold music for the resident while technicians are called. On branch iris-troubleshoots-while-searching
# the default is "off": Iris keeps troubleshooting with the resident instead. Set a number of seconds
# (music starts that long after Iris asks for a technician) to switch the music back on.
# HOLD_MUSIC_DELAY_SEC=off
# When a technician does not pick up, the music stops so Iris can tell the resident. It comes
# back this many seconds later. Raise it if Iris gets cut off, lower it if there is a silent gap.
# HOLD_MUSIC_RESUME_SEC=13
# Cues to Iris (technician updates, "No technician is available") wait until nobody has been
# talking for this many milliseconds, but never longer than CUE_MAX_WAIT_MS.
# CUE_QUIET_GAP_MS=700
# CUE_MAX_WAIT_MS=8000
# When a technician joins, they wait on hold (and muted) until Iris has been quiet for
# HANDOVER_GRACE_MS, so she is never cut off; then she is muted and the technician brought in.
# HANDOVER_MAX_WAIT_MS is only a safety net in case Twilio never reports that she stopped.
# HANDOVER_MAX_WAIT_MS=30000
# HANDOVER_GRACE_MS=1500
# When the technician presses 1, Iris is told to wrap up; the handover waits for her reply,
# but goes ahead if she has not started replying within this many ms.
# HANDOVER_WRAPUP_WAIT_MS=6000
# Without hold music, a "technician did not pick up" update reaches Iris in her next
# update_transfer reply; if she makes no such call within this many ms, the audio cue is used.
# UPDATE_FALLBACK_MS=8000
# Music to play: a Twilio hold-music URL, or a direct link to an .mp3 or .wav file.
# HOLD_MUSIC_URL=http://twimlets.com/holdmusic?Bucket=com.twilio.music.classical
# Twilio recordings and live transcripts (branch full-call-recording). All on unless set to false.
# The room recording is always made. RECORD_LEGS adds a dual-channel recording of the resident's
# own line (includes the hold music) and of each technician's line (includes their brief).
# RECORD_LEGS=true
# Twilio Real-Time Transcription of the resident's and each technician's line, both tracks.
# LIVE_TRANSCRIPTION=true
# The same on Iris's leg (she hears the whole room). Set to false if Iris ever fails to connect.
# LIVE_TRANSCRIPTION_IRIS_LEG=true
# Only if your ElevenLabs workspace uses a data-residency host, e.g. https://api.eu.residency.elevenlabs.io
# ELEVENLABS_API_BASE=https://api.elevenlabs.io
